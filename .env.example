# Copy to .env and fill in. See README.md for full explanations of each setting.

# -- BigQuery connection (required) ------------------------------------------
PROJECT_ID=your-gcp-project-id
BQ_DATASET=Vivek
BQ_AUTH_MODE=adc
# Only read when BQ_AUTH_MODE=service_account — path INSIDE the container, matching the
# docker-compose volume mount (./secrets:/secrets:ro).
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/key.json

# -- Scope: the one Striim cluster this instance watches ---------------------
# Leave unset to show the dataset unfiltered (fine if it only ever contains one cluster).
CLUSTER_NAME=

# -- Default lookback windows (all overridable per-request via query params) --
NODE_TREND_DAYS_BACK=7
APP_HISTORY_DEFAULT_DAYS=7
APP_UPTIME_DEFAULT_DAYS=30

# -- Behaviour -----------------------------------------------------------------
QUERY_CACHE_TTL_SECONDS=60
AUTO_REFRESH_SECONDS=60

# -- Server ----------------------------------------------------------------------
APP_PORT=8080
LOG_LEVEL=INFO
